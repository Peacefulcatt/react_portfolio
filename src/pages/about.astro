---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';

const skills = [
  { name: 'Frontend', items: ['React', 'Astro', 'JavaScript', 'HTML/CSS'] },
  { name: 'Backend', items: ['Node.js', 'Express', 'Python', 'Django'] },
  { name: 'Data', items: ['MongoDB', 'PostgreSQL', 'Firebase', 'MySQL'] },
  { name: 'Focus', items: ['AI Systems', 'IoT', 'Healthcare Tech', 'UX Craft'] },
];

const experience = [
  {
    year: '2022 — Present',
    role: 'Senior Software Engineer',
    company: 'Tech Solutions Inc.',
    description: 'Leading frontend development and shipping product features end to end.',
  },
  {
    year: '2019 — 2022',
    role: 'Software Engineer',
    company: 'Digital Innovations',
    description: 'Built and maintained web applications with React and Node.js.',
  },
  {
    year: '2017 — 2019',
    role: 'Junior Developer',
    company: 'StartUp Labs',
    description: 'Shipped responsive interfaces and improved product reliability.',
  },
];
---

<BaseLayout title="About" description={`About ${site.name} — ${site.title}.`}>
  <section class="section">
    <div class="container narrow">
      <h1 class="section-heading reveal">About</h1>
      <div class="intro reveal reveal-delay-1">
        <p class="section-lead">
          I'm a software engineer with 5+ years of experience building digital products.
          My path started with a first website at 15, and grew into a focus on intelligent
          systems for healthcare and connected devices.
        </p>
        <p class="section-lead">
          Away from the keyboard, I'm usually outdoors, reading sci-fi, or testing a new recipe.
        </p>
      </div>
    </div>
  </section>

  <section class="section skills-section">
    <div class="container">
      <h2 class="section-heading reveal">Skills</h2>
      <div class="skills">
        {
          skills.map((skill) => (
            <div class="skill reveal">
              <h3>{skill.name}</h3>
              <p>{skill.items.join(' · ')}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container narrow">
      <h2 class="section-heading reveal">Experience</h2>
      <ol class="timeline">
        {
          experience.map((item) => (
            <li class="reveal">
              <div class="year">{item.year}</div>
              <div>
                <h3>{item.role}</h3>
                <p class="company">{item.company}</p>
                <p>{item.description}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>
</BaseLayout>

<style>
  .narrow {
    max-width: 42rem;
  }

  .intro {
    display: grid;
    gap: 1.25rem;
  }

  .skills-section {
    border-block: 1px solid var(--line);
  }

  .skills {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 2rem;
    margin-top: 2.5rem;
  }

  .skill h3 {
    font-size: 0.95rem;
    margin-bottom: 0.5rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .skill p {
    margin: 0;
    color: var(--muted);
    font-size: 0.98rem;
  }

  .timeline {
    list-style: none;
    margin: 2.5rem 0 0;
    padding: 0;
    display: grid;
    gap: 0;
  }

  .timeline li {
    display: grid;
    grid-template-columns: 9rem 1fr;
    gap: 1.5rem;
    padding: 1.5rem 0;
    border-top: 1px solid var(--line);
  }

  .timeline li:last-child {
    border-bottom: 1px solid var(--line);
  }

  .year {
    font-size: 0.92rem;
    color: var(--muted);
  }

  .timeline h3 {
    font-size: 1.15rem;
    margin-bottom: 0.25rem;
  }

  .company {
    color: var(--muted);
    margin-bottom: 0.4rem;
  }

  .timeline p:last-child {
    margin: 0;
    color: var(--muted);
  }

  @media (max-width: 900px) {
    .skills {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 560px) {
    .skills,
    .timeline li {
      grid-template-columns: 1fr;
    }
  }
</style>
