---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';

const skills = [
  { name: 'Languages', items: ['Python', 'TypeScript', 'Dart'] },
  { name: 'Cloud', items: ['Firebase', 'Firestore', 'REST APIs', 'Qdrant'] },
  { name: 'Product', items: ['Flutter', 'CAD/CAM', 'Computer vision', 'PyQt'] },
  { name: 'Devices', items: ['Embedded Linux', 'Buildroot', 'MQTT', 'SQLite'] },
];
---

<BaseLayout title="About" description={`About ${site.name} — ${site.title}.`}>
  <section class="section">
    <div class="container narrow">
      <h1 class="section-heading reveal">About</h1>
      <div class="intro reveal reveal-delay-1">
        <p class="section-lead">
          I am a software engineer. The work I like has a clear edge: a machine, a small
          device, or a phone talking to a backend. I want to know where the data comes from,
          who is allowed to change it, and what still works when the other side is down.
        </p>
        <p class="section-lead">
          Python is where most of that starts. I use TypeScript on the web and Dart when the
          product is a mobile app. I also have experience on the cloud side, with Firebase
          for sign-in and stored data, and with REST APIs between a client and that data.
          That is a different kind of problem from a device image, and I am at home in both.
        </p>
      </div>
    </div>
  </section>

  <section class="section skills-section">
    <div class="container">
      <h2 class="section-heading reveal">Skills</h2>
      <div class="skills">
        {
          skills.map((skill) => (
            <div class="skill reveal">
              <h3>{skill.name}</h3>
              <p>{skill.items.join(' · ')}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  .narrow {
    max-width: 42rem;
  }

  .intro {
    display: grid;
    gap: 1.25rem;
  }

  .skills-section {
    border-block: 1px solid var(--line);
  }

  .skills {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 2rem;
    margin-top: 2.5rem;
  }

  .skill h3 {
    font-size: 0.95rem;
    margin-bottom: 0.5rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .skill p {
    margin: 0;
    color: var(--muted);
    font-size: 0.98rem;
  }

  @media (max-width: 900px) {
    .skills {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 560px) {
    .skills {
      grid-template-columns: 1fr;
    }
  }
</style>
