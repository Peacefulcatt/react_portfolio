---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';
import { withBase } from '../utils/paths';
---

<BaseLayout>
  <section class="hero">
    <div class="hero-media" aria-hidden="true">
      <img
        src="https://images.unsplash.com/photo-1497366216548-37526070297c?auto=format&fit=crop&w=2000&q=80"
        alt=""
        class="hero-image"
      />
      <div class="hero-veil"></div>
    </div>

    <div class="container hero-content">
      <p class="brand reveal">{site.brand}</p>
      <h1 class="reveal reveal-delay-1">{site.title}</h1>
      <p class="lede reveal reveal-delay-2">{site.tagline}</p>
      <div class="actions reveal reveal-delay-3">
        <a class="btn btn-primary" href={withBase('/contact')}>Hire Me</a>
        <a class="btn btn-secondary" href={withBase('/projects')}>View Work</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    position: relative;
    min-height: calc(100vh - 4rem);
    min-height: calc(100dvh - 4rem);
    display: grid;
    align-items: end;
    overflow: hidden;
    color: #f7f7f5;
  }

  .hero-media {
    position: absolute;
    inset: 0;
  }

  .hero-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(1) contrast(1.05);
    animation: slow-zoom 22s ease-in-out infinite alternate;
  }

  .hero-veil {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgba(17, 17, 17, 0.2) 0%,
      rgba(17, 17, 17, 0.45) 50%,
      rgba(17, 17, 17, 0.82) 100%
    );
  }

  .hero-content {
    position: relative;
    z-index: 1;
    padding: 6rem 0 4rem;
    max-width: 42rem;
  }

  .brand {
    margin: 0 0 0.85rem;
    font-family: var(--font-display);
    font-size: clamp(2.6rem, 8vw, 5rem);
    font-weight: 700;
    letter-spacing: -0.04em;
    line-height: 0.95;
  }

  h1 {
    margin: 0 0 0.85rem;
    font-size: clamp(1.15rem, 2.4vw, 1.5rem);
    font-weight: 500;
    letter-spacing: 0.02em;
    color: rgba(247, 247, 245, 0.88);
  }

  .lede {
    margin: 0 0 1.75rem;
    max-width: 30rem;
    font-size: 1.05rem;
    color: rgba(247, 247, 245, 0.78);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .hero :global(.btn) {
    border-color: rgba(247, 247, 245, 0.85);
    color: #f7f7f5;
  }

  .hero :global(.btn-primary) {
    background: #f7f7f5;
    color: #111;
    border-color: #f7f7f5;
  }

  .hero :global(.btn-primary:hover) {
    background: transparent;
    color: #f7f7f5;
  }

  .hero :global(.btn-secondary:hover) {
    background: #f7f7f5;
    color: #111;
  }

  @media (max-width: 640px) {
    .hero-content {
      padding-bottom: 3rem;
    }
  }
</style>
