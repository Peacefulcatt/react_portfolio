---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';
import { withBase } from '../utils/paths';
---

<BaseLayout>
  <section class="hero">
    <div class="hero-media" aria-hidden="true">
      <img
        src="https://images.unsplash.com/photo-1576091160550-2173dba999ef?auto=format&fit=crop&w=2000&q=80"
        alt=""
        class="hero-image"
      />
      <div class="hero-veil"></div>
    </div>

    <div class="container hero-content">
      <p class="brand reveal">{site.brand}</p>
      <h1 class="reveal reveal-delay-1">{site.title}</h1>
      <p class="lede reveal reveal-delay-2">{site.tagline}</p>
      <div class="actions reveal reveal-delay-3">
        <a class="btn btn-primary" href={withBase('/contact')}>Hire Me</a>
        <a class="btn btn-secondary" href={withBase('/projects')}>View Work</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    position: relative;
    min-height: 100vh;
    min-height: 100dvh;
    display: grid;
    align-items: end;
    overflow: hidden;
    color: #f4f7f8;
  }

  .hero-media {
    position: absolute;
    inset: 0;
  }

  .hero-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    animation: drift 18s ease-in-out infinite alternate;
  }

  .hero-veil {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, rgba(14, 28, 47, 0.25) 0%, rgba(14, 28, 47, 0.55) 45%, rgba(14, 28, 47, 0.88) 100%),
      radial-gradient(800px 400px at 20% 20%, rgba(31, 122, 109, 0.35), transparent 60%);
  }

  .hero-content {
    position: relative;
    z-index: 1;
    padding: 7rem 0 4.5rem;
    max-width: 46rem;
  }

  .brand {
    margin: 0 0 1rem;
    font-family: var(--font-display);
    font-size: clamp(2.8rem, 8vw, 5.6rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 0.95;
  }

  h1 {
    margin: 0 0 1rem;
    font-size: clamp(1.4rem, 3vw, 2rem);
    font-weight: 500;
    color: rgba(244, 247, 248, 0.92);
  }

  .lede {
    margin: 0 0 2rem;
    max-width: 34rem;
    font-size: 1.15rem;
    color: rgba(244, 247, 248, 0.86);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
  }

  .hero :global(.btn-secondary) {
    border-color: rgba(244, 247, 248, 0.75);
    color: #f4f7f8;
  }

  .hero :global(.btn-secondary:hover) {
    background: #f4f7f8;
    color: var(--ink);
  }

  @media (max-width: 640px) {
    .hero-content {
      padding-bottom: 3.25rem;
    }

    .actions {
      width: 100%;
    }

    .actions :global(.btn) {
      flex: 1;
    }
  }
</style>
