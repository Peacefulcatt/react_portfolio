---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';
import { withBase } from '../utils/paths';
---

<BaseLayout>
  <section class="hero">
    <div class="hero-atmosphere" aria-hidden="true">
      <div class="glow glow-a"></div>
      <div class="glow glow-b"></div>
      <div class="grid"></div>
    </div>

    <div class="container hero-content">
      <p class="brand reveal">{site.brand}</p>
      <h1 class="reveal reveal-delay-1">{site.title}</h1>
      <p class="lede reveal reveal-delay-2">{site.tagline}</p>
      <div class="actions reveal reveal-delay-3">
        <a class="btn btn-primary" href={withBase('/contact')}>Hire Me</a>
        <a class="btn btn-secondary" href={withBase('/projects')}>View Work</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    position: relative;
    min-height: calc(100vh - 4rem);
    min-height: calc(100dvh - 4rem);
    display: grid;
    align-items: center;
    overflow: hidden;
  }

  .hero-atmosphere {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .glow {
    position: absolute;
    border-radius: 50%;
    filter: blur(40px);
    opacity: 0.55;
    animation: drift-soft 16s ease-in-out infinite alternate;
  }

  .glow-a {
    width: min(50vw, 28rem);
    height: min(50vw, 28rem);
    top: 8%;
    right: 6%;
    background: rgba(17, 17, 17, 0.08);
  }

  .glow-b {
    width: min(42vw, 22rem);
    height: min(42vw, 22rem);
    bottom: 10%;
    left: 4%;
    background: rgba(17, 17, 17, 0.05);
    animation-delay: -6s;
  }

  .grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(17, 17, 17, 0.045) 1px, transparent 1px),
      linear-gradient(90deg, rgba(17, 17, 17, 0.045) 1px, transparent 1px);
    background-size: 72px 72px;
    mask-image: radial-gradient(circle at 30% 40%, black 20%, transparent 72%);
    animation: fade-in 1.2s ease both;
  }

  .hero-content {
    position: relative;
    z-index: 1;
    padding: 5rem 0;
    max-width: 44rem;
  }

  .brand {
    margin: 0 0 1rem;
    font-family: var(--font-display);
    font-size: clamp(3rem, 9vw, 5.75rem);
    font-weight: 700;
    letter-spacing: -0.045em;
    line-height: 0.92;
  }

  h1 {
    margin: 0 0 1rem;
    font-size: clamp(1.15rem, 2.2vw, 1.45rem);
    font-weight: 500;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .lede {
    margin: 0 0 2rem;
    max-width: 30rem;
    font-size: 1.08rem;
    color: var(--muted);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  @keyframes drift-soft {
    from {
      transform: translate3d(0, 0, 0);
    }
    to {
      transform: translate3d(2%, -3%, 0);
    }
  }

  @media (max-width: 640px) {
    .hero-content {
      padding: 3.5rem 0 3rem;
    }

    .actions {
      width: 100%;
    }

    .actions :global(.btn) {
      flex: 1;
    }
  }
</style>
