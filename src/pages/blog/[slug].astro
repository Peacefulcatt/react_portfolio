---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const dateLabel = post.data.date.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<BaseLayout title={post.data.title} description={post.data.excerpt}>
  <article class="section">
    <div class="container article">
      <a class="back" href={`${base}/blog`}>← Back to Blog</a>
      <header class="reveal">
        <h1>{post.data.title}</h1>
        <div class="meta">
          <time datetime={post.data.date.toISOString()}>{dateLabel}</time>
          <span>{post.data.readTime}</span>
        </div>
        <div class="tags">
          {post.data.tags.map((tag) => <span class="tag">{tag}</span>)}
        </div>
      </header>
      <div class="content reveal reveal-delay-1">
        <Content />
      </div>
    </div>
  </article>
</BaseLayout>

<style>
  .article {
    max-width: 46rem;
  }

  .back {
    display: inline-block;
    margin-bottom: 1.5rem;
    text-decoration: none;
    font-weight: 600;
    color: var(--teal-deep);
  }

  header h1 {
    font-size: clamp(2rem, 5vw, 3.2rem);
    margin-bottom: 1rem;
  }

  .meta {
    display: flex;
    gap: 1rem;
    color: var(--ink-soft);
    margin-bottom: 1rem;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-bottom: 2rem;
  }

  .content :global(h2) {
    margin-top: 2rem;
    font-size: 1.6rem;
  }

  .content :global(h3) {
    margin-top: 1.5rem;
  }

  .content :global(p),
  .content :global(li) {
    color: var(--ink-soft);
    font-size: 1.05rem;
  }

  .content :global(img) {
    width: 100%;
    border-radius: var(--radius);
    margin: 1.5rem 0;
    border: 1px solid var(--line);
  }

  .content :global(pre) {
    overflow-x: auto;
    padding: 1rem 1.1rem;
    border-radius: var(--radius);
    background: var(--ink);
    color: #e8eef3;
    margin: 1.25rem 0;
  }

  .content :global(code) {
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.92em;
  }

  .content :global(:not(pre) > code) {
    background: rgba(14, 28, 47, 0.08);
    padding: 0.1rem 0.35rem;
    border-radius: 0.25rem;
  }

  .content :global(ul),
  .content :global(ol) {
    padding-left: 1.25rem;
  }
</style>
