---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import BlogFilter from '../../components/BlogFilter';
import type { BlogCard } from '../../components/BlogFilter';
import { withBase } from '../../utils/paths';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

const cards: BlogCard[] = posts.map((post) => ({
  id: post.id,
  title: post.data.title,
  excerpt: post.data.excerpt,
  date: post.data.date.toISOString(),
  dateLabel: post.data.date.toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  }),
  tags: post.data.tags,
  readTime: post.data.readTime,
  href: withBase(`/blog/${post.id}`),
}));
---

<BaseLayout
  title="Blog"
  description="Notes on AI, engineering practice, and building useful software."
>
  <section class="section">
    <div class="container">
      <h1 class="section-heading reveal">Blog</h1>
      <p class="section-lead reveal reveal-delay-1">
        Notes on engineering, AI, and building useful software.
      </p>
      <div class="wrap reveal reveal-delay-2">
        <BlogFilter client:load posts={cards} />
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .wrap {
    margin-top: 3rem;
    max-width: 46rem;
  }
</style>
